# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=admin
MYSQL_PASSWORD=password
MYSQL_DATABASE=figurebox

# Backend
DATABASE_URL=mysql+pymysql://admin:password@db:3306/figurebox
SECRET_KEY=your-secret-key-change-in-production

# MinIO 对象存储（内部通信用，供后端服务直连 MinIO）
MINIO_ROOT_USER=figurebox
MINIO_ROOT_PASSWORD=FigureBox@2024!
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=figurebox
MINIO_SECRET_KEY=FigureBox@2024!
MINIO_BUCKET=figurebox-images

# MinIO 用户配置（供前端/用户连接 MinIO 使用）
MINIO_PUBLIC_ENDPOINT=http://localhost:28640
MINIO_PUBLIC_URL=http://localhost:28620/minio
MINIO_SECURE=false
MINIO_REGION=us-east-1
